{
  "name": "@bgs/ingestion",
  "version": "0.0.0",
  "private": true,
  "description": "Collects official content (presidence.sn) and turns it into validated, traceable articles",
  "type": "module",
  "scripts": {
    "collect": "tsx src/cli/collect-latest.ts",
    "backfill": "tsx src/cli/backfill.ts",
    "watch": "tsx src/cli/watch.ts",
    "covers": "tsx src/cli/backfill-covers.ts",
    "inline-images": "tsx src/cli/inline-images.ts",
    "documents": "tsx src/cli/documents.ts",
    "withdrawn": "tsx src/cli/withdrawn.ts",
    "procedures": "tsx src/cli/procedures.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "procedures:themes": "tsx src/cli/procedure-themes.ts",
    "services:osm": "tsx src/cli/state-services.ts",
    "content:import": "tsx src/cli/import-to-database.ts",
    "translate:wolof": "tsx --env-file-if-exists=../../apps/api/.env.local src/cli/translate-wolof.ts"
  },
  "dependencies": {
    "@bgs/content-store": "workspace:*",
    "@bgs/database": "workspace:*",
    "@bgs/resilience": "workspace:*",
    "@bgs/shared-types": "workspace:*",
    "blurhash": "2.0.5",
    "dom-serializer": "3.1.1",
    "domhandler": "6.0.1",
    "htmlparser2": "12.0.0",
    "sanitize-html": "2.18.0",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/sanitize-html": "2.16.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
