{
  "name": "@bgs/api",
  "version": "0.0.0",
  "private": true,
  "description": "Public REST API (/v1) for the Bic Gouv SN app",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --import ./src/instrument.ts src/server.ts",
    "build": "tsdown",
    "start": "node --import ./dist/instrument.mjs dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@bgs/shared-types": "workspace:*",
    "@fastify/swagger": "9.9.0",
    "@fastify/swagger-ui": "6.1.1",
    "@sentry/node": "10.75.2",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "7.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "tsdown": "0.23.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
