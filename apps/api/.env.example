# Environment variables of the API (set them in the hosting platform, never in the code).
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000
# Sentry project key for the API; crash reporting stays off while empty.
SENTRY_DSN=
# Share of requests traced for performance, 0 to 1.
SENTRY_TRACES_SAMPLE_RATE=0.02
# Admin console sign-in. Without this key, the /admin/v1 routes are not served.
# 32 random bytes in base64, generated once per environment and kept secret:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
ADMIN_SECRET_KEY=
# Provisional admin stores (PostgreSQL later).
ADMIN_ACCOUNTS_PATH=.data/admin/accounts.json
ADMIN_AUDIT_PATH=.data/admin/audit.jsonl
