# Environment variables of the API (set them in the hosting platform, never in the code).
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000
# Proxies in front of the API (CDN, load balancer): their number ("2" for CDN +
# load balancer) or their addresses ("10.0.0.0/8,127.0.0.1"). Required behind them,
# or every limit per address counts everyone as one. Empty in development.
TRUST_PROXY=
# Sentry project key for the API; crash reporting stays off while empty.
SENTRY_DSN=
# Share of requests traced for performance, 0 to 1.
SENTRY_TRACES_SAMPLE_RATE=0.02
# Admin console sign-in. Without this key, the /admin/v1 routes are not served.
# Never typed, copied or shown (docs/securite-des-secrets.md). In development,
# `pnpm --filter @bgs/api admin:rotate-key` creates or replaces it in .env.local
# without displaying it; in production, the hosting secret manager generates it.
ADMIN_SECRET_KEY=
# Replaced keys, comma-separated, only while `admin:reseal` seals the secrets again.
ADMIN_SECRET_KEYS_PREVIOUS=
# Provisional admin stores (PostgreSQL later).
ADMIN_ACCOUNTS_PATH=.data/admin/accounts.json
ADMIN_AUDIT_PATH=.data/admin/audit.jsonl
# Assistant (questions and « Est-ce vrai ? »): key of the Anthropic account, with a
# monthly spending limit set in that account. Typed by the owner only, in
# .env.local or the hosting secret manager, never shown nor sent in a message.
# Empty: the assistant says it is not available yet; the rest of the app works.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-haiku-4-5-20251001
# The assistant also searches by meaning (open model multilingual-e5-small, MIT, run
# on this server: about 400 MB of memory, a few minutes of computing the first time,
# then only for new articles). Vectors and model under ASSISTANT_VECTORS_ROOT.
ASSISTANT_SEMANTIC_SEARCH=on
ASSISTANT_VECTORS_ROOT=.data/assistant
