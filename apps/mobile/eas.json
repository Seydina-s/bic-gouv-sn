{
  "cli": {
    "version": ">= 24.8.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "24.21.0",
      "pnpm": "12.6.0",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "node": "24.21.0",
      "pnpm": "12.6.0",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "channel": "preview"
    },
    "testflight": {
      "distribution": "store",
      "environment": "preview",
      "node": "24.21.0",
      "pnpm": "12.6.0",
      "autoIncrement": true,
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "channel": "preview"
    }
  },
  "submit": {
    "testflight": {
      "ios": {}
    }
  }
}
