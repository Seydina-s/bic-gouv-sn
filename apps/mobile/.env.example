# Copy to .env.local (never committed) and fill in.
# Sentry project key for the mobile app (public by design, but kept out of the code).
EXPO_PUBLIC_SENTRY_DSN=
# development | preview | production
EXPO_PUBLIC_APP_ENV=development
# Base URL of the public API, e.g. http://192.168.1.14:3100 to test on a phone on the same Wi-Fi.
EXPO_PUBLIC_API_URL=
