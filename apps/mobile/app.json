{
  "expo": {
    "name": "Bic Gouv SN",
    "slug": "bic-gouv-sn",
    "scheme": "bicgouvsn",
    "version": "0.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-font",
      "expo-splash-screen",
      "expo-image",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Bic Gouv SN utilise votre position sur votre téléphone, sans jamais l’envoyer, pour trouver les services de l’État les plus proches.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://de.sentry.io/",
          "organization": "bic-gouv-sn",
          "project": "bic-gouv-sn-mobile"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
